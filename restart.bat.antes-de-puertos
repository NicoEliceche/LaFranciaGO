@echo off
setlocal EnableExtensions

set "PORT=8081"
set "ROOT=%~dp0"
set "URL=http://localhost:%PORT%/"

echo.
echo ==========================================
echo   LaFranciaGO - restart dev server
echo ==========================================
echo.

pushd "%ROOT%"

echo [1/3] Revisando si el puerto %PORT% ya esta en uso...
for /f "tokens=5" %%P in ('netstat -ano ^| findstr /R /C:":%PORT% .*LISTENING"') do (
  echo       Deteniendo PID %%P
  taskkill /F /T /PID %%P >nul 2>nul
)

echo [2/3] Levantando la web...
start "LaFranciaGO Dev" /D "%ROOT%" cmd /k npm run dev

echo [3/3] Abriendo el navegador...
timeout /t 3 /nobreak >nul
start "" "%URL%"

popd
endlocal
exit /b 0
