{
  "name": "lafranciago-api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "setup": "node setup.mjs",
    "typecheck": "tsc --noEmit",
    "db:migrar": "wrangler d1 migrations apply lafranciago --remote",
    "db:migrar:local": "wrangler d1 migrations apply lafranciago --local",
    "db:migrar:prod": "wrangler d1 migrations apply lafranciago-prod --remote --env prod",
    "deploy:prod": "wrangler deploy --env prod"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260906.1",
    "typescript": "^5.4.5",
    "wrangler": "^4.129.0"
  }
}
