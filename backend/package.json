{
  "name": "lafranciago-api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:local": "wrangler d1 execute lafranciago --local --file=./migrations/0001_esquema_inicial.sql",
    "db:remoto": "wrangler d1 execute lafranciago --remote --file=./migrations/0001_esquema_inicial.sql",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20240909.0",
    "typescript": "^5.4.5",
    "wrangler": "^3.78.0"
  }
}
