{
  "name": "lafranciago-escritorio",
  "version": "1.0.0",
  "description": "LaFranciaGO en la computadora del negocio: lectora, impresora y ventas sin internet.",
  "main": "principal.js",
  "private": true,
  "scripts": {
    "dev": "electron .",
    "empaquetar": "electron-builder --win --x64",
    "probar-ticket": "node probar-ticket.js"
  },
  "devDependencies": {
    "electron": "^34.0.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "ar.com.lafranciago.escritorio",
    "productName": "LaFranciaGO",
    "directories": {
      "output": "salida"
    },
    "files": [
      "*.js",
      "../dist/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "LaFranciaGO"
    }
  }
}
