{
  "name": "lafranciago-escritorio",
  "version": "1.0.0",
  "description": "LaFranciaGO en la computadora del negocio: lectora, impresora y ventas sin internet.",
  "main": "principal.js",
  "private": true,
  "scripts": {
    "dev": "electron .",
    "empaquetar": "electron-builder --win --x64",
    "probar-ticket": "node probar-ticket.js",
    "postinstall": "node node_modules/electron/install.js",
    "reparar": "node node_modules/electron/install.js"
  },
  "devDependencies": {
    "electron": "^34.0.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "ar.com.lafranciago.escritorio",
    "productName": "LaFranciaGO",
    "directories": {
      "output": "salida"
    },
    "files": [
      "*.js",
      "../dist/**/*"
    ],
    "protocols": [
      {
        "name": "LaFranciaGO",
        "schemes": [
          "lafranciago"
        ]
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "publisherName": "Nicolas Eliceche",
      "legalTrademarks": "LaFranciaGO",
      "signAndEditExecutable": true
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "LaFranciaGO",
      "perMachine": false,
      "allowElevation": false,
      "deleteAppDataOnUninstall": false,
      "uninstallDisplayName": "LaFranciaGO"
    },
    "copyright": "Copyright 2026 Nicolas Eliceche"
  },
  "author": {
    "name": "Nicolas Eliceche",
    "email": "nico.elicechediz@gmail.com"
  },
  "homepage": "https://nicoeliceche.github.io/LaFranciaGO/"
}
